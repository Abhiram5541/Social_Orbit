{
  // Use the TypeScript that ships with the repo, not the editor's bundled copy.
  // Next 16 and TS 5 disagree with older SDKs about several types, and a
  // mismatch shows errors in the editor that `npm run typecheck` does not.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // There is no Prettier in this project. ESLint is the only formatter, so
  // "format on save" means "apply the lint rules that can be fixed safely".
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,

  // Tailwind v4 keeps its tokens in globals.css via @theme — there is no
  // tailwind.config.js to point the extension at.
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
  ],

  // Build output, the ingested database and test artifacts are noise in search.
  // They are hidden from search and file-watching, not from the explorer —
  // .data/ingested.json is worth being able to open.
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.data": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/.playwright-mcp": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.data/**": true,
    "**/test-results/**": true
  },

  "files.exclude": {
    "**/.next": true,
    "**/tsconfig.tsbuildinfo": true
  },

  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // The E2E suite drives a real browser against the dev server; running it from
  // the test explorer without this picks up the wrong working directory.
  "playwright.env": { "E2E_BASE_URL": "http://localhost:3000" }
}
