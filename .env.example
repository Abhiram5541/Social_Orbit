# ---------------------------------------------------------------------------
# SENSO environment template.
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth ------------------------------------------------------------------
# Signs session cookies. Minimum 32 characters. The app refuses to boot in
# production without it. Generate: openssl rand -base64 48
AUTH_SECRET=

# Shared password for the development seed accounts. Development only —
# there are no seed accounts under the Postgres driver.
DEV_SEED_PASSWORD=SENSO-Dev-2026

# Sign-in attempts allowed per client address per minute. Leave unset in
# production to use the built-in default of 10. Raised locally only because the
# E2E suite drives every sign-in from one loopback address.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Data driver -----------------------------------------------------------
# `development` keeps the influencer database in .data/ingested.json.
# `postgres` keeps it in DATABASE_URL, loaded once at boot and written through
# on every mutation. Local database: `docker compose up -d`. A Postgres with no
# creators imports the JSON file on first boot, so switching loses nothing.
SOCIALORBIT_DATA_DRIVER=development

# --- Database (used when SOCIALORBIT_DATA_DRIVER=postgres) ------------------
DATABASE_URL=postgresql://user:password@localhost:5432/socialorbit

# --- Redis / queues --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Encryption ------------------------------------------------------------
# Encrypts OAuth access/refresh tokens at rest. 32-byte key, base64 encoded.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- YouTube Data API v3 ---------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/internal/connect/youtube/callback

# --- X (Twitter) API v2 -----------------------------------------------------
# OAuth 1.0a consumer pair, used only to mint an app-only OAuth2 bearer token
# (POST https://api.twitter.com/oauth2/token, client_credentials grant). This
# is what reads public account/post data — no user sign-in required.
X_API_KEY=
X_API_SECRET=
# Sign-in-with-X (OAuth2 + PKCE), for account connection and identity
# verification. Leave empty until a developer app is registered for it — the
# connector reports credentials_missing and every other feature keeps working.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:3000/api/internal/connect/x/callback
# Set to "true" once a live probe confirms reads succeed with no HTTP 402.
# The admin connector grid cannot detect billing state on its own — it only
# reads local records — so this is the operator's signal, not a live check.
X_BILLING_ACTIVE=

# --- Meta / Instagram Graph API --------------------------------------------
# Instagram insights require a professional account and app review.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/internal/connect/instagram/callback
META_GRAPH_VERSION=v21.0
# Business Discovery runs as SENSO's own Instagram professional account: its
# id, and a long-lived Page token that reaches it (scripts/meta-token.mjs).
META_IG_USER_ID=
META_IG_TOKEN=
# "Instagram API with Instagram Login" has its own app id/secret (Dashboard →
# Instagram → API setup with Instagram login); the secret exchanges and
# refreshes an IGAA… token.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Further `userId:token` pairs, comma separated — every linked Page the token
# holder manages is another 200 reads an hour (scripts/meta-token.mjs --pool).
META_IG_POOL=

# --- TikTok (roadmap — DPR §29) --------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AI providers ----------------------------------------------------------
# OpenAI is primary; Gemini validates high-value or conflicting facts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Object storage (reports, exports) -------------------------------------
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- External API signing --------------------------------------------------
# Pepper applied before hashing customer API keys. Rotating it invalidates
# every issued key, so treat it as permanent.
API_KEY_PEPPER=

# --- Scheduled jobs --------------------------------------------------------
# In-process daily jobs on a long-lived server: every account re-read for a
# snapshot, and the next few searches of the discovery rotation. Runs after the
# hour below (UTC; YouTube's quota resets at midnight Pacific) and at most once
# per day, catching up if the server was down. Leave unset on Vercel, where
# the cron routes below do the same work.
# "true" puts the shared seed password into the public sign-in page's picker
# so a demo can click through the seats. Turn it off and rotate the password
# once real users exist.
SOCIALORBIT_DEMO_LOGINS=
SOCIALORBIT_DAILY_JOBS=
SOCIALORBIT_DAILY_JOBS_HOUR_UTC=9
SOCIALORBIT_DISCOVERY_SEARCHES_PER_DAY=10

# Authenticates the daily snapshot job at /api/internal/cron/snapshot. Vercel
# Cron sends it as `Authorization: Bearer <value>`. The job refuses to run
# without it — the endpoint spends API quota. Generate: openssl rand -base64 32
CRON_SECRET=
